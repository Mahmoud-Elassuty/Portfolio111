# Port the Express API (and static portfolio) is served on.
PORT=5000

# Origin allowed to call the API when the frontend is served separately
# from this backend during development (e.g. VSCode "Live Server").
# Not needed if you open the site through this server (recommended).
ALLOWED_ORIGIN=http://127.0.0.1:5500

# --- SMTP (Nodemailer) --------------------------------------------------
# Server-side only — never exposed to the frontend. All required for the
# contact form to send email. For Gmail: host smtp.gmail.com, port 465
# with SMTP_SECURE=true (implicit TLS), or port 587 with SMTP_SECURE=false
# (STARTTLS). SMTP_PASS must be a Gmail App Password, NOT your normal
# account password — see the README's "Contact Email Delivery" section.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

SMTP_USER=mahmoudalassiouty1@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD

# Inbox that receives contact-form notifications (usually the same as
# SMTP_USER, but doesn't have to be).
CONTACT_TO_EMAIL=mahmoudalassiouty1@gmail.com

# Display name used in the outgoing "From" header. The address itself is
# always SMTP_USER — most SMTP providers (Gmail included) reject sends
# where the From address doesn't match the authenticated account.
CONTACT_FROM_NAME=Mahmoud Hassan
