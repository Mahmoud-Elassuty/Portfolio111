# Copy to .env (local) and add the same two variables in Vercel -> Project -> Settings -> Environment Variables.
# Supabase -> Project Settings -> API. Use the PUBLIC key (anon / publishable). NEVER the service_role / secret key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
